// ────────────────────────────────────────────────────────────────
// 치이카와 심즈 — 애니메이션 클립 라이브러리 (2026-11-05, 우사기 제작)
// 캐릭터 리그(character.js buildCharacter)의 실측 채널에 맞춘 키프레임 데이터.
//
// ■ 왜 자체 제작인가
//   Mixamo·Quaternius·KayKit·CMU 등 무료 모션 에셋은 전부 휴머노이드 스켈레톤
//   전제라, 본이 없는 절차 캐릭터(이 리그)에는 구조적으로 적용 불가 (리서치 완료).
//   외부 클립은 타이밍 레퍼런스로만 쓰고, 클립은 이 포맷으로 직접 저작한다.
//
// ■ 채널 (전부 실측된 기존 채널)
//   posY·posZ     model.position 오프셋 (기본 위치에 가산)
//   rotX·rotY·rotZ model.rotation 오프셋 (라디안)
//   squash        model.scale.y 배율. x/z는 게임 관례대로 1/squash (통통한 볼륨감)
//   armL·armR     팔 관절 각도 (어깨 표면 법선 축 회전, swingArms와 동일 규약)
//   armPitchL·armPitchR 팔 앞뒤 피치 (v2.5) — 관절에 모델 X축 회전을 앞곱한다.
//                 음수 = 손이 앞으로. 그릇 들기·건네기처럼 손이 몸 앞에 와야 읽히는 동작용.
//   armExtL·armExtR 팔 뻗기 0..1 (v2) — 팔이 짧아 회전만으론 안 읽혀서 추가한 채널.
//                 aim 스케일로 팔을 늘이며 살짝 가늘어진다 (1+0.9e, xz 1-0.15e).
//                 적용하려면 buildCharacter 팔 반환에 aim 노출이 필요하다 (feet/tail 패치와 한 묶음).
//   footLZ·footLY·footRZ·footRY  발 위치 오프셋 (기본 z=0.03, y=footH 기준)
//   tail          꼬리 rotation.z (꼬리 있는 캐릭터만)
//   face          표정 id 스텝 키 [[t, 'joy'], ...] — 보간 없이 t 도달 시 교체
//
// ■ 플레이어 적용 조건
//   model·arms·setExpression은 buildCharacter 반환값으로 바로 닿는다.
//   foot/tail 채널은 buildCharacter가 feet/tail을 반환에 노출해야 적용된다
//   (반환 객체에 feet:[footL,footR], tail 추가하는 1줄 패치 — 설계서에 명시).
//   패치가 없으면 해당 채널만 건너뛰고 나머지는 정상 재생된다.
//
// ■ 쫀득·말랑 연출 수칙 (이재헌 지시, 2026-11-05)
//   - 변형은 "사건"에서만 일어난다: 착지·이륙·방향 전환·놀람·씹기 같은 박자 지점.
//   - 기본 상태의 변형은 ±0.02 이내 (숨쉬기 수준). 시도 때도 없는 출렁임 금지.
//   - 찌그러짐 0.10~0.16초로 짧게 → 'back' 이징으로 한 번만 살짝 오버슛해 복귀.
//     푸딩처럼 계속 흐물거리지 않고, 말랑한 고무처럼 톡 돌아오는 것이 기준.
//   - 진폭이 큰 흔들림은 춤·흥얼처럼 리듬이 본체인 클립에서만 허용.
//
// ■ 키 형식: [시간초, 값, 이징] — 이징은 "이 키에서 다음 키로 갈 때"의 곡선.
//   'lin' 직선 / 'io' 부드럽게(smoothstep) / 'out' 빠르게 붙고 천천히(easeOutCubic)
//   'back' 오버슛 복귀(easeOutBack — 쫀득) / 'snap' 급격히(easeOutQuart)
// ────────────────────────────────────────────────────────────────

const ANIM_EASES = {
  lin: u => u,
  io: u => u * u * (3 - 2 * u),
  out: u => 1 - Math.pow(1 - u, 3),
  snap: u => 1 - Math.pow(1 - u, 4),
  back: u => { const c = 1.70158; return 1 + (c + 1) * Math.pow(u - 1, 3) + c * Math.pow(u - 1, 2); },
};

// 트랙 샘플링: 키 배열 [[t, v, ease?], ...] 에서 시각 t의 값을 구한다.
function animSampleTrack(keys, t) {
  if (!keys || keys.length === 0) return 0;
  if (t <= keys[0][0]) return keys[0][1];
  for (let i = 0; i < keys.length - 1; i++) {
    const [t0, v0, ease] = keys[i];
    const [t1, v1] = keys[i + 1];
    if (t <= t1) {
      const u = t1 === t0 ? 1 : (t - t0) / (t1 - t0);
      const f = (ANIM_EASES[ease] || ANIM_EASES.io)(u);
      return v0 + (v1 - v0) * f;
    }
  }
  return keys[keys.length - 1][1];
}

const ANIM_CHANNELS = ['posY', 'posZ', 'rotX', 'rotY', 'rotZ', 'squash', 'armL', 'armR', 'armExtL', 'armExtR', 'armPitchL', 'armPitchR', 'footLZ', 'footLY', 'footRZ', 'footRY', 'tail'];
const ANIM_DEFAULTS = { posY: 0, posZ: 0, rotX: 0, rotY: 0, rotZ: 0, squash: 1, armL: 0, armR: 0, armExtL: 0, armExtR: 0, armPitchL: 0, armPitchR: 0, footLZ: 0, footLY: 0, footRZ: 0, footRY: 0, tail: 0 };

// 클립을 시각 t에 샘플링해 포즈 객체로 돌려준다. loop 클립은 dur로 나눈 나머지를 쓴다.
function animSampleClip(clip, t) {
  const time = clip.loop ? (t % clip.dur) : Math.min(t, clip.dur);
  const pose = { ...ANIM_DEFAULTS };
  for (const ch of ANIM_CHANNELS) {
    if (clip.tracks[ch]) pose[ch] = animSampleTrack(clip.tracks[ch], time);
  }
  if (clip.face) {
    let face = clip.face[0][1];
    for (const [ft, id] of clip.face) if (time >= ft) face = id;
    pose.face = face;
  }
  return pose;
}

// 포즈를 actor에 적용한다. playAct와 같은 규약: 매 프레임 base에서 다시 쌓는다.
function animApplyPose(actor, pose) {
  const model = actor.built.model;
  const { position, rotation, scale } = actor.base;
  model.position.set(position.x, position.y + pose.posY, position.z + pose.posZ);
  model.rotation.set(rotation.x + pose.rotX, rotation.y + pose.rotY, rotation.z + pose.rotZ);
  model.scale.set(scale.x / pose.squash, scale.y * pose.squash, scale.z / pose.squash);
  const [armL, armR] = actor.built.arms;
  armL.joint.quaternion.setFromAxisAngle(armL.normal, pose.armL);
  armR.joint.quaternion.setFromAxisAngle(armR.normal, pose.armR);
  if (typeof THREE !== 'undefined' && (pose.armPitchL || pose.armPitchR)) {
    const X = new THREE.Vector3(1, 0, 0);
    if (pose.armPitchL) armL.joint.quaternion.premultiply(new THREE.Quaternion().setFromAxisAngle(X, pose.armPitchL));
    if (pose.armPitchR) armR.joint.quaternion.premultiply(new THREE.Quaternion().setFromAxisAngle(X, pose.armPitchR));
  }
  if (armL.aim) armL.aim.scale.set(1 - 0.15 * pose.armExtL, 1 + 0.9 * pose.armExtL, 1 - 0.15 * pose.armExtL);
  if (armR.aim) armR.aim.scale.set(1 - 0.15 * pose.armExtR, 1 + 0.9 * pose.armExtR, 1 - 0.15 * pose.armExtR);
  if (actor.built.feet) {
    const [footL, footR] = actor.built.feet;
    footL.position.z = 0.03 + pose.footLZ;
    footR.position.z = 0.03 + pose.footRZ;
    footL.position.y = actor.built.footH + pose.footLY;
    footR.position.y = actor.built.footH + pose.footRY;
  }
  if (actor.built.tail) actor.built.tail.rotation.z = pose.tail;
  if (pose.face && actor.built.getExpression() !== pose.face) actor.built.setExpression(pose.face);
}

