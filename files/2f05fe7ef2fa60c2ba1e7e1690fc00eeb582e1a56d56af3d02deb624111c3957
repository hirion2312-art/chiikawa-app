<script>
// 얼굴 설정 파일(face-map.json) 불러오기: persona.js가 localStorage의 값을 읽어 표정 표에 덮는다
(function () {
  var btn = document.getElementById('faceBtn'), input = document.getElementById('faceFile');
  if (!btn || !input) return;
  function mark(t) { btn.textContent = t; setTimeout(function () { btn.textContent = '얼'; }, 1600); }
  btn.addEventListener('click', function () { input.click(); });
  input.addEventListener('change', function () {
    var f = input.files && input.files[0];
    input.value = '';
    if (!f) return;
    f.text().then(function (t) {
      try {
        var j = JSON.parse(t);
        if (!j || !j.faces) throw new Error('faces 없음');
        localStorage.setItem('chiikawa-face-map', JSON.stringify(j));
        mark('✓');
      } catch (e) { mark('!'); }
    }).catch(function () { mark('!'); });
  });
})();
</script>
